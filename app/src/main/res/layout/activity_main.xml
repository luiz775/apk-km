<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:background="@drawable/bg_ambient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO DE VIAGEM"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:letterSpacing="0.15"
                    android:shadowColor="#4DFFFFFF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="2dp"
                    android:background="@drawable/bg_title_glow"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtOlaUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋 Olá, Luiz Gustavo"
                    android:textColor="@color/accent_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnConfiguracoes"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_button_modern"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="Configurações"
                app:tint="@color/text_main" />
        </RelativeLayout>

        <!-- DASHBOARD CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <!-- KM CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_button_modern"
                android:padding="12dp"
                android:layout_marginEnd="6dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛣️ Total KM"
                    android:textColor="@color/accent_blue"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.8"/>
                <TextView
                    android:id="@+id/txtDashKmTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- CUSTO CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_button_modern"
                android:padding="12dp"
                android:layout_marginHorizontal="3dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Custo Total"
                    android:textColor="@color/accent_green"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.8"/>
                <TextView
                    android:id="@+id/txtDashCustoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 0,00"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- RECIBOS CARD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_button_modern"
                android:padding="12dp"
                android:layout_marginStart="6dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Recibos"
                    android:textColor="@color/accent_gold"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.8"/>
                <TextView
                    android:id="@+id/txtDashRecibosTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FOTOS SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOTOS DA VIAGEM"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/btnFotoIda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:background="@drawable/bg_button_modern"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.5">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#26FF5C2B"
                    android:gravity="center"
                    android:text="📸"
                    android:textSize="20sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOTO IDA"
                    android:textColor="@color/accent_orange"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque para capturar"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnFotoVolta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:background="@drawable/bg_button_modern"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.5">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#263D7FFF"
                    android:gravity="center"
                    android:text="📷"
                    android:textSize="20sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOTO VOLTA"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque para capturar"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SCAN BUTTON -->
        <LinearLayout
            android:id="@+id/btnFotoDespesa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_scan_modern"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.5">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#26A259FF"
                android:gravity="center"
                android:text="📄"
                android:textSize="18sp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escanear Recibo"
                    android:textColor="#E6A259FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCR automático · Despesas"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- DATA SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DADOS DA VIAGEM"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_modern"
            android:layout_marginBottom="20dp">

            <!-- DATA -->
            <LinearLayout
                android:id="@+id/row_data"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="15sp" android:layout_marginEnd="12dp" android:alpha="0.5"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATA" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <EditText android:id="@+id/editData" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="DD/MM/AAAA" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:inputType="phone"/>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

            <!-- CONDUTOR -->
            <LinearLayout
                android:id="@+id/row_condutor"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="15sp" android:layout_marginEnd="12dp" android:alpha="0.5"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MOTORISTA" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <EditText android:id="@+id/editCondutor" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:text="Luiz Gustavo" android:textColor="@color/text_main" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

            <!-- HORARIOS -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/row_hSaida"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕐" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAÍDA" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <EditText android:id="@+id/editHoraSaida" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="00:00" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:inputType="time"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border_color"/>
                <LinearLayout
                    android:id="@+id/row_hChegada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕔" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHEGADA" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <EditText android:id="@+id/editHoraChegada" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="00:00" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:inputType="time"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

            <!-- KMs -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/row_kmIni"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛣️" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KM INICIAL" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <EditText android:id="@+id/editKmInicial" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="0" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:inputType="number"/>
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border_color"/>
                <LinearLayout
                    android:id="@+id/row_kmFin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏁" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KM FINAL" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <EditText android:id="@+id/editKmFinal" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="0" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:inputType="number"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

            <!-- ORIGEM / DESTINO -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/row_origem"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ORIGEM" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <AutoCompleteTextView android:id="@+id/editOrigem" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="Saída" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:completionThreshold="1"/>
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnGpsOrigem"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="@color/accent_orange"
                        android:alpha="0.6"
                        android:contentDescription="GPS Origem"/>
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border_color"/>
                <LinearLayout
                    android:id="@+id/row_destino"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯" android:textSize="15sp" android:layout_marginEnd="10dp" android:alpha="0.5"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DESTINO" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                        <AutoCompleteTextView android:id="@+id/editDestino" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="Chegada" android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:completionThreshold="1"/>
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnGpsDestino"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="@color/accent_blue"
                        android:alpha="0.6"
                        android:contentDescription="GPS Destino"/>
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color"/>

            <!-- OBS -->
            <LinearLayout
                android:id="@+id/row_obs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="start"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="15sp" android:layout_marginEnd="12dp" android:alpha="0.5"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OBSERVAÇÕES" android:textSize="9sp" android:textColor="@color/text_muted" android:textStyle="bold" android:letterSpacing="0.1"/>
                    <EditText android:id="@+id/editObservacoes" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:hint="Detalhes adicionais..." android:textColor="@color/text_main" android:textColorHint="#40F0F0F5" android:textSize="14sp" android:minLines="2" android:gravity="top" android:inputType="textMultiLine"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- VEICULO SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIPO DE VIAGEM"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"/>

        <RadioGroup
            android:id="@+id/radioGroupVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioParticular"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/bg_radio_modern"
                android:button="@null"
                android:padding="12dp"
                android:text="Particular\nUso pessoal"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:layout_marginEnd="5dp"
                android:gravity="center_vertical"
                android:drawableStart="@android:drawable/btn_radio"
                android:drawablePadding="8dp"
                app:buttonTint="@color/accent_orange" />

            <RadioButton
                android:id="@+id/radioEmpresa"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/bg_radio_modern"
                android:button="@null"
                android:padding="12dp"
                android:text="Empresa\nUso corporativo"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:drawableStart="@android:drawable/btn_radio"
                android:drawablePadding="8dp"
                app:buttonTint="@color/accent_blue" />
        </RadioGroup>

        <!-- ACTIONS SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnAdicionar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Adicionar"
                android:backgroundTint="@color/accent_green"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:layout_marginEnd="5dp"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnGerarPdf"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Gerar PDF"
                android:backgroundTint="@color/accent_blue"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:layout_marginStart="5dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCompartilhar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Compartilhar Último PDF"
            android:backgroundTint="@color/surface"
            android:textColor="@color/accent_gold"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            app:strokeColor="#4DF59E0B"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

        <!-- LISTA SECTION -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viagens do Dia"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtViagensCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0 registros"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:background="@drawable/bg_button_modern"
                android:padding="4dp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/containerViagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Limpar Tudo · Novo Dia"
            android:backgroundTint="@android:color/transparent"
            android:textColor="#B3EF4444"
            app:strokeColor="#4DEF4444"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Aplicativo criado por Luiz Gustavo"
            android:textColor="#33F0F0F5"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.05" />

    </LinearLayout>
</ScrollView>