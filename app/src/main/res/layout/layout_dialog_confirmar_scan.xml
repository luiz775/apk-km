<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_modern"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#33FFFFFF"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONFIRMAR RECIBO"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp"/>

    <!-- Preview da Imagem -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:backgroundTint="@color/surface2"
        android:layout_marginBottom="20dp">
        <ImageView
            android:id="@+id/imgPreviewScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:padding="4dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A imagem está na posição correta?"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnConfirmarScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SIM, SALVAR"
            android:backgroundTint="@color/accent_green"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGirarScan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="GIRAR 180°"
                android:backgroundTint="#26FFFFFF"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"
                app:cornerRadius="12dp"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnRepetirScan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="REPETIR"
                android:backgroundTint="#14EF4444"
                android:textColor="#EF4444"
                android:layout_marginStart="4dp"
                app:cornerRadius="12dp"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>